# Copy to protected OS configuration, never commit the filled file.
CLINIC_MODE=lan
CLINIC_DATABASE_URL=postgresql://clinic_app:REPLACE_WITH_UNIQUE_PASSWORD@127.0.0.1:5432/minhduc
CLINIC_DATA_DIR=/var/lib/minhduc
CLINIC_UPLOAD_DIR=/var/lib/minhduc/attachments
CLINIC_ORIGIN=https://minhduc.internal:8443
CLINIC_BIND_IP=192.168.10.10
CLINIC_ALLOWED_CIDRS=192.168.10.0/24
CLINIC_TLS_CERT=/etc/minhduc/tls/server.crt
CLINIC_TLS_KEY=/etc/minhduc/tls/server.key
CLINIC_BACKUP_KEEP=30
