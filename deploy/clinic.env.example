# Copy to protected OS configuration, never commit the filled file.
CLINIC_MODE=lan
CLINIC_DATABASE_URL=postgresql://clinic_app:REPLACE_WITH_UNIQUE_PASSWORD@127.0.0.1:5432/minhduc
CLINIC_DATA_DIR=/var/lib/minhduc
CLINIC_UPLOAD_DIR=/var/lib/minhduc/attachments
CLINIC_ORIGIN=https://minhduc.internal:8443
CLINIC_BIND_IP=192.168.10.10
CLINIC_ALLOWED_CIDRS=192.168.10.0/24
CLINIC_TLS_CERT=/etc/minhduc/tls/server.crt
CLINIC_TLS_KEY=/etc/minhduc/tls/server.key
CLINIC_BACKUP_KEEP=7
# 8 GB machine: validated, bounded resource settings. Security remains enabled.
CLINIC_WORKERS=1
CLINIC_POOL_MIN=1
CLINIC_POOL_MAX=4
CLINIC_THREAD_LIMIT=8
CLINIC_CONCURRENCY=48
CLINIC_EXPORT_SLOTS=1
CLINIC_EXPORT_MAX_MB=10
CLINIC_UPLOAD_MAX_MB=5
CLINIC_UPLOAD_TOTAL_MB=2048
CLINIC_MIN_FREE_MB=10240
CLINIC_BACKUP_TOTAL_MB=20480
CLINIC_REQUIRE_OFFSITE=0
CLINIC_OFFSITE_KEEP=30
# Existing external USB/NAS destination, already mounted; never put keys here.
# CLINIC_BACKUP_OFFSITE_DIR=...
# Real data acceptance requires REQUIRE_OFFSITE=1 and a verified off-server copy.
