[Unit]
Description=Minh Duc synthetic LAN clinic pilot (HTTPS)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=minhduc
Group=minhduc
WorkingDirectory=/opt/minhduc
EnvironmentFile=/etc/minhduc/clinic.env
ExecStart=/opt/minhduc/.venv/bin/python -m scripts.run_lan
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/minhduc
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
