[Unit]
Description=Encrypted Minh Duc PostgreSQL and attachment backup
After=postgresql.service

[Service]
Type=oneshot
User=minhduc
Group=minhduc
WorkingDirectory=/opt/minhduc
EnvironmentFile=/etc/minhduc/clinic.env
ExecStart=/opt/minhduc/.venv/bin/python -m scripts.backup_lan backup --key /etc/minhduc/backup.key --directory /var/lib/minhduc/backups
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/minhduc
