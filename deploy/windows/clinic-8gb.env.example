# Literal KEY=VALUE, no quotes; never commit the filled credential file.
CLINIC_MODE=lan
CLINIC_DATABASE_URL=postgresql://clinic_app:REPLACE_WITH_UNIQUE_PASSWORD@127.0.0.1:5432/minhduc
CLINIC_DATA_DIR=C:\ProgramData\MinhDuc
CLINIC_UPLOAD_DIR=C:\ProgramData\MinhDuc\attachments
CLINIC_ORIGIN=https://minhduc.internal:8443
CLINIC_BIND_IP=192.168.10.10
CLINIC_ALLOWED_CIDRS=192.168.10.0/24
CLINIC_TLS_CERT=C:\ProgramData\MinhDuc\tls\server.crt
CLINIC_TLS_KEY=C:\ProgramData\MinhDuc\tls\server.key
CLINIC_PG_DUMP=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
CLINIC_PG_RESTORE=C:\Program Files\PostgreSQL\17\bin\pg_restore.exe
CLINIC_PG_LOG_DIR=C:\Program Files\PostgreSQL\17\data\log
CLINIC_WORKERS=1
CLINIC_POOL_MIN=1
CLINIC_POOL_MAX=4
CLINIC_THREAD_LIMIT=8
CLINIC_CONCURRENCY=24
CLINIC_EXPORT_SLOTS=1
CLINIC_EXPORT_MAX_MB=10
CLINIC_UPLOAD_MAX_MB=5
CLINIC_UPLOAD_TOTAL_MB=2048
CLINIC_MIN_FREE_MB=10240
CLINIC_BACKUP_TOTAL_MB=20480
CLINIC_BACKUP_KEEP=7
CLINIC_REQUIRE_OFFSITE=0
CLINIC_OFFSITE_KEEP=30
# Set REQUIRE_OFFSITE=1 and an existing off-server directory before real-data acceptance.
# CLINIC_BACKUP_OFFSITE_DIR=E:\MinhDucEncryptedBackups
